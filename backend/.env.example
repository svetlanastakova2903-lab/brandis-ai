ANTHROPIC_API_KEY=sk-ant-...
PORT=3000
DATA_MODE=test

# Публичный адрес этого бэкенда (для return_url платежей ЮKassa). На Render — https://brandis-ai.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Postgres (Supabase/Neon/другой managed Postgres — НЕ бесплатный Postgres на Render, он удаляется через 30 дней)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Если подключаешься к обычному Postgres без SSL (локальная разработка) — выстави false
PGSSL=true

# Telegram-бот (авторизация)
TELEGRAM_BOT_TOKEN=123456:ABC-...
# Необязательно — если не задать, бэкенд один раз сам спросит через getMe() и закеширует в памяти
TELEGRAM_BOT_USERNAME=

# ЮKassa (оплата подписки и пакетов)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Модель для сжатия истории диалога (дешевле основной)
SUMMARY_MODEL=claude-haiku-4-5
